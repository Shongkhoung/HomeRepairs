<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Background color -->
    <solid android:color="#1280ED"/>



    <!-- Rounded corners -->
    <corners android:radius="8dp"/>

    <stroke
        android:width="2sp"
        android:color="#1280ED"
        />
    <!-- Padding inside the shape -->
    <padding
        android:left="12dp"
        android:top="12dp"
        android:right="12dp"
        android:bottom="12dp" />
</shape>
