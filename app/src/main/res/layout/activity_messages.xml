<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_gray">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingBottom="80dp"
        android:background="@color/background_gray">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="20dp"
                android:paddingBottom="12dp"
                android:background="@color/white">

                <!-- Title and Action Buttons Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/title_messages"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:textColor="@color/gray_900" />

                        <TextView
                            android:id="@+id/tvUnreadCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/msg_no_unread"
                            android:textSize="12sp"
                            android:textColor="@color/gray_600"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        
                        <ImageButton
                            android:id="@+id/btnFilter"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_tune"
                            app:tint="@color/gray_600"
                            android:padding="10dp"
                            android:contentDescription="Filter" />


                    </LinearLayout>
                </LinearLayout>

                <!-- Search Bar -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/gray_100"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E5E7EB"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp"
                        android:gravity="center_vertical"
                        android:minHeight="44dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_search"
                            app:tint="@color/text_hint"
                            android:layout_marginEnd="10dp" />

                        <EditText
                            android:id="@+id/etSearch"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="@string/hint_search_messages"
                            android:textSize="14sp"
                            android:textColor="@color/gray_900"
                            android:textColorHint="@color/text_hint"
                            android:background="@android:color/transparent"
                            android:inputType="text"
                            android:maxLines="1" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Filter Tabs -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:overScrollMode="never">

                    <LinearLayout
                        android:id="@+id/llFilterTabs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingBottom="8dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAll"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="All (0)"
                            android:textSize="12sp"
                            android:textAllCaps="false"
                            android:background="@drawable/bg_pill_selected"
                            android:textColor="@color/white"
                            android:layout_marginEnd="8dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingHorizontal="16dp"
                            app:backgroundTint="@null"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnUnread"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="Unread (0)"
                            android:textSize="12sp"
                            android:textAllCaps="false"
                            android:background="@drawable/bg_pill_unselected"
                            android:textColor="@color/gray_700"
                            android:layout_marginEnd="8dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingHorizontal="16dp"
                            app:backgroundTint="@null"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPinned"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="Pinned (0)"
                            android:textSize="12sp"
                            android:textAllCaps="false"
                            android:background="@drawable/bg_pill_unselected"
                            android:textColor="@color/gray_700"
                            android:layout_marginEnd="8dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingHorizontal="16dp"
                            app:backgroundTint="@null"/>

                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>

            <!-- Selection Action Bar -->
            <LinearLayout
                android:id="@+id/llSelectionBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingVertical="12dp"
                android:background="@color/background_gray"
                android:gravity="center_vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvSelectedCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/msg_selected_count"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMarkRead"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_mark_read"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:minHeight="36dp"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    app:cornerRadius="18dp"
                    app:backgroundTint="@color/white"
                    android:textColor="@color/bright_periwinkle_blue"
                    app:icon="@drawable/ic_check"
                    app:iconTint="@color/bright_periwinkle_blue"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    android:layout_marginEnd="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeleteSelected"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dialog_delete_confirm"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:minHeight="36dp"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    app:cornerRadius="18dp"
                    app:backgroundTint="@color/error"
                    android:textColor="@color/text_white"
                    app:icon="@drawable/ic_back_arrow"
                    app:iconTint="@color/text_white"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp" />
            </LinearLayout>

            <!-- Container for Messages List and Empty State -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="600dp">
                
                <!-- Messages List -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvConversations"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:nestedScrollingEnabled="false" />

                <!-- Empty State -->
                <LinearLayout
                    android:id="@+id/llEmptyState"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="32dp"
                    android:visibility="gone">

                <!-- Icon with Circular Background -->
                <FrameLayout
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_marginBottom="24dp"
                    android:gravity="center">
                    
                    <View
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:background="@drawable/circle_indicator"
                        android:backgroundTint="@color/background_gray" />
                    
                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@drawable/message"
                        android:tint="@color/text_secondary"
                        android:contentDescription="Message icon" />
                </FrameLayout>

                <!-- Title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_no_messages"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="8dp" />

                <!-- Subtitle -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/subtitle_no_messages"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:gravity="center"
                    android:layout_marginBottom="32dp"
                    android:paddingHorizontal="16dp" />

                <!-- Browse Services Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBrowseServices"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="@string/btn_browse_services"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_white"
                    android:minHeight="48dp"
                    android:minWidth="200dp"
                    android:paddingHorizontal="32dp"
                    app:cornerRadius="24dp"
                    app:backgroundTint="@color/text_primary"
                    app:elevation="2dp" />
            </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        style="@style/BottomNavNoIndicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bottom_nav_background"
        app:elevation="0dp"
        app:menu="@menu/bottom_navigation"
        app:itemIconTint="@drawable/bottom_nav_selector"
        app:itemTextColor="@drawable/bottom_nav_selector" />

    <!-- Internet Connection Loading Overlay -->
    <FrameLayout
        android:id="@+id/llInternetLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/overlay_background"
        android:visibility="gone"
        android:elevation="16dp"
        android:clickable="true"
        android:focusable="true">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/overlay_background"
            android:clickable="true"
            android:focusable="true" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/ivNoConnection"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_marginBottom="8dp"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/no_connection" />

            <TextView
                android:id="@+id/tvInternetMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/msg_no_internet"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/error"
                android:gravity="center"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Screen Transition Loading Overlay -->
    <FrameLayout
        android:id="@+id/llScreenLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/overlay_background"
        android:visibility="gone"
        android:elevation="20dp"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/ivScreenLoading"
                android:layout_width="320dp"
                android:layout_height="320dp"
                android:layout_marginBottom="16dp"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_speed="1.0"
                app:lottie_renderMode="hardware"
                app:lottie_rawRes="@raw/loading" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/msg_loading"
                android:textSize="16sp"
                android:textColor="@color/text_white"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
