<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray_50">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="100dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Sticky Header Emulation -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/white"
                android:paddingBottom="12dp"
                android:elevation="4dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="16dp">

                    <View
                        android:id="@+id/btnClose"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true" />
                    
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_close"
                        app:tint="@color/gray_900"
                        android:layout_alignStart="@id/btnClose"
                        android:layout_alignTop="@id/btnClose"
                        android:layout_alignEnd="@id/btnClose"
                        android:layout_alignBottom="@id/btnClose"
                        android:padding="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Review &amp; Confirm"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/gray_900"
                        android:layout_centerInParent="true" />
                </RelativeLayout>

                <!-- Progress Indicator -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="3"
                    android:paddingHorizontal="20dp"
                    android:paddingBottom="4dp">
                    
                    <View
                        android:layout_width="0dp"
                        android:layout_height="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/shape_pill"
                        android:backgroundTint="@color/primary_blue"
                        android:layout_marginEnd="6dp"/>
                    <View
                        android:layout_width="0dp"
                        android:layout_height="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/shape_pill"
                        android:backgroundTint="@color/primary_blue"
                        android:layout_marginEnd="6dp"/>
                    <View
                        android:layout_width="0dp"
                        android:layout_height="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/shape_pill"
                        android:backgroundTint="@color/gray_200"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Service Card -->
                 <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Service"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/gray_900"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/gray_100"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:gravity="center_vertical">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            app:cardCornerRadius="14dp"
                            app:cardBackgroundColor="@color/primary_blue"
                            app:strokeWidth="0dp"
                            app:cardElevation="4dp">
                            <!-- Using a simple gradient background or solid color -->
                             <ImageView
                                 android:layout_width="32dp"
                                 android:layout_height="32dp"
                                 android:layout_gravity="center"
                                 android:src="@drawable/ic_tools" 
                                 app:tint="@color/white" />
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="16dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvServiceType"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Plumbing Repair"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/gray_900" />

                            <TextView
                                android:id="@+id/tvServiceProvider"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Service by Alex Bennett"
                                android:textSize="12sp"
                                android:textColor="@color/gray_600" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Information Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Booking Details"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/gray_900"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/gray_100"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Date Time -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="14dp"
                            android:orientation="horizontal">
                            
                             <View
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_icon_rounded"
                                android:backgroundTint="@color/blue_50"/>
                                
                             <!-- Using negative margin overlay or just properly positioning image inside -->
                             <ImageView
                                 android:layout_width="20dp"
                                 android:layout_height="20dp"
                                 android:src="@drawable/ic_calendar"
                                 app:tint="@color/blue_600"
                                 android:layout_marginStart="-30dp"
                                 android:layout_marginTop="10dp"/>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="24dp"
                                android:orientation="vertical">
                                <TextView
                                    android:id="@+id/tvServiceDateTime"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Sunday, January 18, 3:00 PM"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/gray_900" />
                                <TextView
                                    android:id="@+id/tvDuration"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Scheduled Time (2 hours)"
                                    android:textSize="12sp"
                                    android:textColor="@color/gray_600" />
                            </LinearLayout>
                        </LinearLayout>
                        
                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/gray_100"/>

                         <!-- Location -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="14dp"
                            android:orientation="horizontal">
                            
                             <View
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_icon_rounded"
                                android:backgroundTint="@color/rose_50"/>
                                
                             <ImageView
                                 android:layout_width="20dp"
                                 android:layout_height="20dp"
                                 android:src="@drawable/ic_location"
                                 app:tint="@color/rose_600"
                                 android:layout_marginStart="-30dp"
                                 android:layout_marginTop="10dp"/>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="24dp"
                                android:orientation="vertical">
                                <TextView
                                    android:id="@+id/tvLocationValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Home, 123 Maple Street"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/gray_900" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Service Location"
                                    android:textSize="12sp"
                                    android:textColor="@color/gray_600" />
                            </LinearLayout>
                        </LinearLayout>
                        
                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/gray_100"/>
                        
                        <!-- Issue -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="14dp"
                            android:orientation="horizontal">
                            
                             <View
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_icon_rounded"
                                android:backgroundTint="@color/amber_50"/>
                                
                             <ImageView
                                 android:layout_width="20dp"
                                 android:layout_height="20dp"
                                 android:src="@drawable/ic_document"
                                 app:tint="@color/amber_600"
                                 android:layout_marginStart="-30dp"
                                 android:layout_marginTop="10dp"/>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="24dp"
                                android:orientation="vertical">
                                <TextView
                                    android:id="@+id/tvIssueDescription"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Description"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/gray_900" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Issue Description"
                                    android:textSize="12sp"
                                    android:textColor="@color/gray_600" />
                            </LinearLayout>
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Payment Methods -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Payment Method"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/gray_900"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="12dp" />

                <!-- Credit Card -->
                <LinearLayout
                    android:id="@+id/llPaymentCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/payment_method_selected"
                    android:padding="14dp"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp"
                    android:clickable="true"
                    android:focusable="true">

                    <View
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icon_rounded"
                        android:backgroundTint="@color/white"/>
                    <ImageView
                         android:layout_width="20dp"
                         android:layout_height="20dp"
                         android:src="@drawable/ic_credit_card"
                         app:tint="@color/teal_600"
                         android:layout_marginStart="-30dp"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Credit/Debit Card"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/gray_900"
                        android:layout_marginStart="24dp"/>

                    <ImageView
                        android:id="@+id/radioCard"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/radio_button_selected_teal"/>
                </LinearLayout>

                <!-- Wallet -->
                 <LinearLayout
                    android:id="@+id/llPaymentWallet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/payment_method_unselected"
                    android:padding="14dp"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp"
                    android:clickable="true"
                    android:focusable="true">

                    <View
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icon_rounded"
                        android:backgroundTint="@color/purple_50_react"/>
                    <ImageView
                         android:layout_width="20dp"
                         android:layout_height="20dp"
                         android:src="@drawable/ic_wallet"
                         app:tint="@color/purple_600_react"
                         android:layout_marginStart="-30dp"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Apple / Google Pay"
                        android:textSize="14sp"
                        android:textStyle="normal"
                        android:textColor="@color/gray_700"
                        android:layout_marginStart="24dp"/>

                    <ImageView
                        android:id="@+id/radioWallet"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/radio_button_unselected_gray"/>
                </LinearLayout>

                <!-- QR -->
                 <LinearLayout
                    android:id="@+id/llPaymentQR"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/payment_method_unselected"
                    android:padding="14dp"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp"
                    android:clickable="true"
                    android:focusable="true">

                    <View
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icon_rounded"
                        android:backgroundTint="@color/blue_50"/>
                    <ImageView
                         android:layout_width="20dp"
                         android:layout_height="20dp"
                         android:src="@drawable/ic_qr_code"
                         app:tint="@color/blue_600"
                         android:layout_marginStart="-30dp"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="QR Code"
                        android:textSize="14sp"
                        android:textStyle="normal"
                        android:textColor="@color/gray_700"
                        android:layout_marginStart="24dp"/>

                    <ImageView
                        android:id="@+id/radioQR"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/radio_button_unselected_gray"/>
                </LinearLayout>

                <!-- Cash -->
                 <LinearLayout
                    android:id="@+id/llPaymentCash"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/payment_method_unselected"
                    android:padding="14dp"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp"
                    android:clickable="true"
                    android:focusable="true">

                    <View
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icon_rounded"
                        android:backgroundTint="@color/orange_50"/>
                    <ImageView
                         android:layout_width="20dp"
                         android:layout_height="20dp"
                         android:src="@drawable/ic_cash"
                         app:tint="@color/orange_600"
                         android:layout_marginStart="-30dp"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Cash on Delivery"
                        android:textSize="14sp"
                        android:textStyle="normal"
                        android:textColor="@color/gray_700"
                        android:layout_marginStart="24dp"/>

                    <ImageView
                        android:id="@+id/radioCash"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/radio_button_unselected_gray"/>
                </LinearLayout>

                <!-- Cost Summary -->
                 <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_rounded_white"
                    android:elevation="1dp"
                    android:layout_marginTop="16dp"
                    android:padding="16dp">
                    
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                         <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="16dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Cost Summary"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/gray_900"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Promo Code"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="@color/teal_600"/>
                        </LinearLayout>

                        <!-- Input -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:background="@color/gray_50"
                            android:paddingStart="12dp"
                            android:paddingVertical="4dp"
                            android:layout_marginBottom="16dp"
                            android:gravity="center_vertical"
                            android:backgroundTint="@color/gray_100">
                             <ImageView
                                 android:layout_width="16dp"
                                 android:layout_height="16dp"
                                 android:src="@drawable/ic_tag"
                                 app:tint="@color/gray_600"/>
                             <EditText
                                android:id="@+id/etPromoCode"
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:background="@null"
                                android:hint="Have a promo code?"
                                android:textSize="14sp"
                                android:paddingStart="8dp"
                                android:inputType="textCapCharacters"/>
                        </LinearLayout>

                        <!-- Fee Rows -->
                         <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="8dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" text="Service Fee" android:textColor="@color/gray_600" android:textSize="14sp"/>
                            <TextView android:id="@+id/tvServiceFee" android:layout_width="wrap_content" android:layout_height="wrap_content" text="$120" android:textColor="@color/gray_900" android:textStyle="bold" android:textSize="14sp"/>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="8dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" text="Booking Fee" android:textColor="@color/gray_600" android:textSize="14sp"/>
                            <TextView android:id="@+id/tvBookingFee" android:layout_width="wrap_content" android:layout_height="wrap_content" text="$10" android:textColor="@color/gray_900" android:textStyle="bold" android:textSize="14sp"/>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="12dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" text="Taxes" android:textColor="@color/gray_600" android:textSize="14sp"/>
                            <TextView android:id="@+id/tvTaxes" android:layout_width="wrap_content" android:layout_height="wrap_content" text="$5" android:textColor="@color/gray_900" android:textStyle="bold" android:textSize="14sp"/>
                        </LinearLayout>

                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider_gray" android:layout_marginBottom="12dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" text="Total" android:textColor="@color/gray_900" android:textSize="16sp" android:textStyle="bold"/>
                            <TextView android:id="@+id/tvTotalEstimate" android:layout_width="wrap_content" android:layout_height="wrap_content" text="$135" android:textColor="@color/primary_blue" android:textStyle="bold" android:textSize="18sp"/>
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>

                <!-- Terms -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="top"
                    android:layout_marginTop="20dp"
                    android:paddingBottom="20dp">
                    <CheckBox
                        android:id="@+id/cbTermsOfService"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:checked="true"
                        android:background="@null"
                        android:buttonTint="@color/teal_500"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="I agree to the Terms of Service and Privacy Policy"
                        android:textSize="12sp"
                        android:textColor="@color/gray_600"
                        android:layout_marginStart="8dp"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

     <!-- Bottom Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#FFFFFFFF"
        android:padding="20dp"
        android:elevation="10dp"
        android:orientation="horizontal">

        <android.widget.Button
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/gray_700"
            android:background="@drawable/bg_button_cancel"
            android:layout_marginEnd="8dp"
            style="?android:attr/borderlessButtonStyle"/>

        <android.widget.Button
            android:id="@+id/btnConfirmBooking"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="Confirm"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/bg_button_confirm"
            android:layout_marginStart="8dp"
            style="?android:attr/borderlessButtonStyle"/>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
