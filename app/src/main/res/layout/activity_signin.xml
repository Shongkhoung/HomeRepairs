            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">



                <TextView
                    android:id="@+id/rememberLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Remember me"
                    android:textSize="16sp"
                    android:layout_marginStart="8dp"
                    app:layout_constraintStart_toEndOf="@id/rememberCheck"
                    app:layout_constraintBaseline_toBaselineOf="@id/rememberCheck" />
                <CheckBox
                    android:id="@+id/rememberCheck"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/ic_unchecked"
                    android:layout_marginLeft="220dp"
                    android:padding="4dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    app:layout_constraintTop_toTopOf="parent"
