<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_gray">

    <!-- Sticky Header (Custom implementation required for "sticky", standard approach is simpler)
         Reference: Sticky top header. Using basic header in ScrollView or simpler approach.
         Actually reference has sticky header. AppBarLayout provides this. -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:elevation="1dp">

        <androidx.appcompat.widget.Toolbar
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:contentInsetStart="0dp"
            android:contentInsetStartWithNavigation="0dp"
            app:contentInsetStart="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_back_arrow"
                    app:tint="@color/text_primary"
                    android:padding="8dp"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/btnShare"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_share"
                    app:tint="@color/text_primary"
                    android:padding="8dp"/>
            </LinearLayout>
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingBottom="100dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="80dp">

            <!-- Profile Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Profile Image (Rounded Square) -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        app:cardCornerRadius="40dp"
                        app:cardElevation="0dp"
                        android:layout_marginEnd="16dp">
                        <ImageView
                            android:id="@+id/ivProfilePicture"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@color/primary_blue"
                            android:scaleType="centerCrop"/>
                        <!-- Text Fallback (Programmatically controlled visibility) -->
                        <TextView
                            android:id="@+id/tvProfileInitials"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="SP"
                            android:textColor="@color/white"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:background="@color/primary_blue"
                            android:visibility="gone"/>

                    </androidx.cardview.widget.CardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <TextView
                                android:id="@+id/tvProviderName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Srey Pen"
                                android:textSize="28sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary"/>

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvProfession"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Professional Appliance Technician"
                            android:textSize="14sp"
                            android:textColor="@color/text_secondary"
                            android:layout_marginTop="4dp"/>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="8dp">
                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_star"
                                app:tint="@color/rating_gold"/>
                            <TextView
                                android:id="@+id/tvRating"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="3.7"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary"
                                android:layout_marginStart="4dp"/>
                            <TextView
                                android:id="@+id/tvReviewCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="(234 reviews)"
                                android:textColor="@color/text_secondary"
                                android:layout_marginStart="4dp"
                                android:textSize="14sp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="6dp">
                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_location"
                                app:tint="@color/text_secondary"/>
                            <TextView
                                android:id="@+id/tvLocation"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Phnom Penh, Cambodia"
                                android:textSize="14sp"
                                android:textColor="@color/text_secondary"
                                android:layout_marginStart="4dp"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Badges -->
                <LinearLayout
                    android:id="@+id/llBadges"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp">
                    <!-- Badges (Hardcoded based on design) -->
                    <LinearLayout
                        android:id="@+id/layoutBadgeVerified"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_green"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:gravity="center_vertical"
                        android:layout_marginEnd="8dp">
                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_check_circle"
                            app:tint="@color/green_800"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Verified Pro"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/green_800"
                            android:layout_marginStart="4dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/layoutBadgeTopRated"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_blue"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:gravity="center_vertical"
                        android:layout_marginEnd="8dp">
                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_thumbs_up"
                            app:tint="@color/blue_800"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Top Rated"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/blue_800"
                            android:layout_marginStart="4dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/layoutBadgeFastResponse"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_purple"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_trending_up"
                            app:tint="@color/purple_800"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Fast Response"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/purple_800"
                            android:layout_marginStart="4dp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Stats Grid -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <!-- Jobs -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="82dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/bg_stat_card_blue"
                        android:padding="8dp"
                        android:gravity="center"
                        android:layout_marginEnd="8dp">
                        <TextView
                            android:id="@+id/tvJobsCount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="163+"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/blue_800"
                            android:gravity="center"
                            android:maxLines="1"
                            app:autoSizeTextType="uniform"
                            app:autoSizeMinTextSize="10sp"
                            app:autoSizeMaxTextSize="16sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Jobs Done"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/text_secondary" />
                    </LinearLayout>

                    <!-- Repeat -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="82dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/bg_stat_card_green"
                        android:padding="8dp"
                        android:gravity="center"
                        android:layout_marginEnd="8dp">
                        <TextView
                            android:id="@+id/tvRepeatRate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="75%"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/green_800"
                            android:gravity="center"
                            android:maxLines="1"
                            app:autoSizeTextType="uniform"
                            app:autoSizeMinTextSize="10sp"
                            app:autoSizeMaxTextSize="16sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Repeat"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/text_secondary" />
                    </LinearLayout>

                    <!-- Arrival -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="82dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/bg_stat_card_purple"
                        android:padding="8dp"
                        android:gravity="center"
                        android:layout_marginEnd="8dp">
                        <TextView
                            android:id="@+id/tvArrival"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="~32 mins"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/purple_800"
                            android:gravity="center"
                            android:maxLines="1"
                            app:autoSizeTextType="uniform"
                            app:autoSizeMinTextSize="10sp"
                            app:autoSizeMaxTextSize="16sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Arrival"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/text_secondary" />
                    </LinearLayout>

                    <!-- Experience -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="82dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/bg_stat_card_orange"
                        android:padding="8dp"
                        android:gravity="center">
                        <TextView
                            android:id="@+id/tvExperience"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="11y"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/orange_900"
                            android:gravity="center"
                            android:maxLines="1"
                            app:autoSizeTextType="uniform"
                            app:autoSizeMinTextSize="10sp"
                            app:autoSizeMaxTextSize="16sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Experience"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/text_secondary" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Pricing Banner -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/primary_blue">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Hourly Rate"
                                android:textColor="@color/white_80"
                                android:textSize="14sp"
                                android:textStyle="bold"/>
                            <TextView
                                android:id="@+id/tvPricing"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="$56 - $106"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:textColor="@color/white" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="per hour"
                                android:textColor="@color/white_80"
                                android:textSize="14sp" />
                        </LinearLayout>
                        <com.google.android.material.button.MaterialButton
                             android:id="@+id/btnBookTop"
                             android:layout_width="wrap_content"
                             android:layout_height="wrap_content"
                             android:text="Book Now"
                             android:textColor="@color/primary_blue"
                             app:backgroundTint="@color/white"
                             android:textStyle="bold"
                             app:cornerRadius="12dp"
                             android:paddingHorizontal="24dp"
                             android:paddingVertical="10dp"/>
                    </LinearLayout>
                    
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/white_30"/>
                        
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Includes: Tools &amp; Equipment • 30-Day Warranty • Free Consultation"
                        android:textColor="@color/white_90"
                        android:textSize="12sp"
                        android:layout_marginTop="16dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>



            <!-- About Section -->
            <LinearLayout
                android:id="@+id/layoutAbout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/white"
                android:padding="16dp"
                android:layout_marginBottom="8dp">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_verified"
                        app:tint="@color/primary_blue"
                        android:layout_marginEnd="8dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="About Me"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="@color/text_primary"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvAbout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Professional Appliance services with over 11 years of experience..."
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingMultiplier="1.2" />

                <!-- Specializations -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Specializations"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="12dp"/>
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupSpecializations"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <!-- Service Areas -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Service Areas"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="12dp"/>
                <TextView
                    android:id="@+id/tvServiceArea"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Phnom Penh"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"/>

                 <!-- Certifications -->
                 <LinearLayout
                     android:id="@+id/layoutCertifications"
                     android:layout_width="match_parent"
                     android:layout_height="wrap_content"
                     android:orientation="horizontal"
                     android:gravity="center_vertical"
                     android:layout_marginTop="16dp"
                     android:visibility="gone">
                     <ImageView
                         android:layout_width="20dp"
                         android:layout_height="20dp"
                         android:src="@drawable/ic_shield"
                         app:tint="@color/primary_blue"
                         android:layout_marginEnd="8dp"/>
                     <TextView
                         android:layout_width="wrap_content"
                         android:layout_height="wrap_content"
                         android:text="Professional Certification Verified"
                         android:textColor="@color/text_primary"
                         android:textStyle="bold"
                         android:textSize="14sp"/>
                 </LinearLayout>

                <!-- Availability -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Availability"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="12dp"/>
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/background_gray"
                    android:padding="16dp">
                     <LinearLayout
                         android:layout_width="match_parent"
                         android:layout_height="wrap_content"
                         android:orientation="horizontal"
                         android:layout_marginBottom="8dp">
                         <TextView
                             android:layout_width="0dp"
                             android:layout_height="wrap_content"
                             android:layout_weight="1"
                             android:text="Working Hours"
                             android:textColor="@color/text_secondary"
                             android:textSize="14sp"/>
                         <TextView
                             android:layout_width="wrap_content"
                             android:layout_height="wrap_content"
                             android:text="8:00 AM - 6:00 PM"
                             android:textColor="@color/text_primary"
                             android:textStyle="bold"
                             android:textSize="14sp"/>
                     </LinearLayout>
                     <LinearLayout
                         android:layout_width="match_parent"
                         android:layout_height="wrap_content"
                         android:orientation="horizontal"
                         android:layout_marginBottom="8dp">
                         <TextView
                             android:layout_width="0dp"
                             android:layout_height="wrap_content"
                             android:layout_weight="1"
                             android:text="Available Days"
                             android:textColor="@color/text_secondary"
                             android:textSize="14sp"/>
                         <TextView
                             android:layout_width="wrap_content"
                             android:layout_height="wrap_content"
                             android:text="Monday - Saturday"
                             android:textColor="@color/text_primary"
                             android:textStyle="bold"
                             android:textSize="14sp"/>
                     </LinearLayout>
                     <LinearLayout
                         android:layout_width="match_parent"
                         android:layout_height="wrap_content"
                         android:orientation="horizontal">
                         <TextView
                             android:layout_width="0dp"
                             android:layout_height="wrap_content"
                             android:layout_weight="1"
                             android:text="Response Time"
                             android:textColor="@color/text_secondary"
                             android:textSize="14sp"/>
                         <TextView
                             android:layout_width="wrap_content"
                             android:layout_height="wrap_content"
                             android:text="Within 2 hours"
                             android:textColor="@color/green_800"
                             android:textStyle="bold"
                             android:textSize="14sp"/>
                     </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Services Section -->
            <LinearLayout
                android:id="@+id/layoutServices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/white"
                android:padding="16dp"
                android:layout_marginBottom="8dp">
                
                <TextView
                     android:layout_width="wrap_content"
                     android:layout_height="wrap_content"
                     android:text="Service Packages"
                     android:textStyle="bold"
                     android:textSize="18sp"
                     android:textColor="@color/text_primary"
                     android:layout_marginBottom="16dp"/>
                
                <LinearLayout
                    android:id="@+id/llServicesList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- Reviews Section -->
            <LinearLayout
                android:id="@+id/layoutReviews"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/white"
                android:padding="16dp"
                android:layout_marginBottom="8dp">
                 <TextView
                     android:layout_width="wrap_content"
                     android:layout_height="wrap_content"
                     android:text="Recent Reviews"
                     android:textStyle="bold"
                     android:textSize="18sp"
                     android:textColor="@color/text_primary"
                     android:layout_marginBottom="16dp"/>
                     
                 <!-- Rating Summary -->
                 <LinearLayout
                     android:layout_width="match_parent"
                     android:layout_height="wrap_content"
                     android:background="@color/background_gray"
                     android:padding="16dp"
                     android:orientation="horizontal"
                     android:layout_marginBottom="16dp">
                     <LinearLayout
                         android:layout_width="wrap_content"
                         android:layout_height="wrap_content"
                         android:orientation="vertical"
                         android:gravity="center"
                         android:layout_marginEnd="16dp">
                         <TextView
                             android:id="@+id/tvRatingBig"
                             android:layout_width="wrap_content"
                             android:layout_height="wrap_content"
                             android:text="3.7"
                             android:textSize="32sp"
                             android:textStyle="bold"
                             android:textColor="@color/text_primary"/>
                         <LinearLayout
                             android:layout_width="wrap_content"
                             android:layout_height="wrap_content"
                             android:orientation="horizontal">
                             <ImageView android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/ic_star" app:tint="@color/rating_gold"/>
                             <ImageView android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/ic_star" app:tint="@color/rating_gold"/>
                             <ImageView android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/ic_star" app:tint="@color/rating_gold"/>
                             <ImageView android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/ic_star" app:tint="@color/text_hint"/>
                             <ImageView android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/ic_star" app:tint="@color/text_hint"/>
                         </LinearLayout>
                         <TextView
                             android:id="@+id/tvReviewCountBig"
                             android:layout_width="wrap_content"
                             android:layout_height="wrap_content"
                             android:text="234 reviews"
                             android:textSize="12sp"
                             android:textColor="@color/text_secondary"/>
                     </LinearLayout>
                     <!-- Bars Placeholder -->
                     <LinearLayout
                         android:id="@+id/layoutRatingBreakdown"
                         android:layout_width="match_parent"
                         android:layout_height="wrap_content"
                         android:orientation="vertical"
                         android:gravity="center_vertical" />
                 </LinearLayout>

                 <androidx.recyclerview.widget.RecyclerView
                     android:id="@+id/rvReviews"
                     android:layout_width="match_parent"
                     android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Contact Section -->
            <LinearLayout
                android:id="@+id/layoutContact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/white"
                android:padding="16dp"
                android:layout_marginBottom="8dp">
                 <TextView
                     android:layout_width="wrap_content"
                     android:layout_height="wrap_content"
                     android:text="Contact Information"
                     android:textStyle="bold"
                     android:textSize="18sp"
                     android:textColor="@color/text_primary"
                     android:layout_marginBottom="16dp"/>
                     
                 <!-- Phone Action -->
                 <LinearLayout
                     android:id="@+id/btnContactPhone"
                     android:layout_width="match_parent"
                     android:layout_height="wrap_content"
                     android:orientation="horizontal"
                     android:background="?attr/selectableItemBackground"
                     android:clickable="true"
                     android:focusable="true"
                     android:padding="16dp"
                     android:layout_marginBottom="8dp"
                     android:gravity="center_vertical">
                     <ImageView
                         android:layout_width="24dp"
                         android:layout_height="24dp"
                         android:padding="4dp"
                         android:background="@drawable/bg_stat_card_blue"
                         android:src="@drawable/ic_phone"
                         app:tint="@color/primary_blue"/>
                     <LinearLayout
                         android:layout_width="0dp"
                         android:layout_height="wrap_content"
                         android:layout_weight="1"
                         android:orientation="vertical"
                         android:layout_marginStart="12dp">
                         <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Phone" android:textSize="12sp" android:textColor="@color/text_secondary"/>
                         <TextView android:id="@+id/tvContactPhone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+855 12 345 678" android:textStyle="bold" android:textColor="@color/text_primary"/>
                     </LinearLayout>
                     <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Call Now" android:textColor="@color/primary_blue" android:textStyle="bold"/>
                 </LinearLayout>
                 
                 <!-- Email Action -->
                 <LinearLayout
                     android:id="@+id/btnContactEmail"
                     android:layout_width="match_parent"
                     android:layout_height="wrap_content"
                     android:orientation="horizontal"
                     android:background="?attr/selectableItemBackground"
                     android:clickable="true"
                     android:focusable="true"
                     android:padding="16dp"
                     android:layout_marginBottom="8dp"
                     android:gravity="center_vertical">
                     <ImageView
                         android:layout_width="24dp"
                         android:layout_height="24dp"
                         android:padding="4dp"
                         android:background="@drawable/bg_stat_card_blue"
                         android:src="@drawable/ic_mail"
                         app:tint="@color/primary_blue"/>
                     <LinearLayout
                         android:layout_width="0dp"
                         android:layout_height="wrap_content"
                         android:layout_weight="1"
                         android:orientation="vertical"
                         android:layout_marginStart="12dp">
                         <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Email" android:textSize="12sp" android:textColor="@color/text_secondary"/>
                         <TextView android:id="@+id/tvContactEmail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="srey.pen@email.com" android:textStyle="bold" android:textColor="@color/text_primary"/>
                     </LinearLayout>
                     <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Email" android:textColor="@color/primary_blue" android:textStyle="bold"/>
                 </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Fixed Bottom Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/white"
        android:padding="16dp"
        android:elevation="12dp"
        android:orientation="horizontal"
        android:backgroundTint="@color/white">
        
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMessage"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="MESSAGE"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:letterSpacing="0.05"
            app:cornerRadius="12dp"
            android:textColor="@color/primary_blue"
            app:backgroundTint="@color/white"
            app:strokeColor="#D1D5DB"
            app:strokeWidth="1.5dp"
            app:icon="@drawable/ic_message_circle"
            app:iconTint="@color/primary_blue"
            app:iconSize="18dp"
            app:iconPadding="8dp"
            app:iconGravity="textStart"
            android:layout_marginEnd="12dp"
            app:elevation="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:rippleColor="#1A2563EB"/>
            
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBookNow"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="BOOK NOW"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:letterSpacing="0.05"
            app:cornerRadius="12dp"
            app:backgroundTint="@color/primary_blue"
            android:textColor="@color/white"
            app:icon="@drawable/ic_calendar"
            app:iconTint="@color/white"
            app:iconSize="18dp"
            app:iconPadding="8dp"
            app:iconGravity="textStart"
            app:elevation="4dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:rippleColor="#33FFFFFF"/>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
