<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardConversation"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="20dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Selection Checkbox -->
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/checkboxSelect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:visibility="gone"
            app:buttonTint="@color/bright_periwinkle_blue" />

        <!-- Avatar Container with Badges -->
        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="12dp">

            <!-- Profile Image -->
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/ivProfileImage"
                android:layout_width="46dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_profile"
                app:civ_border_color="@color/bright_periwinkle_blue"
                app:civ_border_width="2dp" />

            <!-- Pinned Badge (Top Right) -->
            <ImageView
                android:id="@+id/ivPinnedBadge"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="top|end"
                android:src="@drawable/pin"
                android:background="@drawable/circle_white"
                android:padding="3dp"
                app:tint="#FF9800"
                android:visibility="gone"
                android:contentDescription="@string/pinned" />

            <!-- Starred Badge (Top Right) -->
            <ImageView
                android:id="@+id/ivStarredBadge"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="top|end"
                android:src="@drawable/ic_star"
                android:background="@drawable/circle_white"
                android:padding="3dp"
                app:tint="#FFB300"
                android:visibility="gone"
                android:contentDescription="@string/starred" />

            <!-- Online Status Dot (Bottom Right) -->
            <View
                android:id="@+id/viewOnlineStatus"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/circle_green"
                android:backgroundTint="@color/available_green"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Content Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="8dp">

            <!-- Name and Timestamp Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <TextView
                    android:id="@+id/tvProviderName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/provider_name"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <!-- Star Icon (if starred) -->
                <ImageView
                    android:id="@+id/ivStarIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_star"
                    app:tint="#FFB300"
                    android:visibility="gone"
                    android:layout_marginStart="4dp"
                    android:contentDescription="@string/starred" />

                <TextView
                    android:id="@+id/tvTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/_9h_ago"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <!-- Message Preview Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Read Checkmark (if read) -->
                <ImageView
                    android:id="@+id/ivReadCheckmark"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_check"
                    app:tint="@color/primary_blue"
                    android:visibility="gone"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="@string/read" />

                <TextView
                    android:id="@+id/tvLastMessage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/last_message_preview"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <!-- Unread Indicator Dot -->
                <View
                    android:id="@+id/viewUnreadIndicator"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/circle_blue"
                    android:backgroundTint="@color/primary_blue"
                    android:visibility="gone" />

                <!-- Unread Count Badge -->
                <TextView
                    android:id="@+id/tvUnreadBadge"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="6dp"
                    android:text="1"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_white"
                    android:gravity="center"
                    android:background="@drawable/circle_blue"
                    android:backgroundTint="@color/bright_periwinkle_blue"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Options Menu (Three Dots) -->
        <ImageButton
            android:id="@+id/btnOptions"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_more_vert"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/more_options"
            app:tint="@color/text_secondary"
            android:padding="8dp" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
