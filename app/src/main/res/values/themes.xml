<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.HomeRepairs" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary brand colors -->
        <item name="colorPrimary">@color/bright_periwinkle_blue</item>
        <item name="colorPrimaryVariant">@color/medium_lavender</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Accent color -->
        <item name="colorSecondary">@color/medium_lavender</item>
        <item name="colorSecondaryVariant">@color/medium_lavender</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Default ripple / material behavior -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

</resources>
