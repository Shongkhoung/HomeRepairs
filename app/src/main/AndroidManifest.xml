<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" 
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HomeRepairs"
        tools:targetApi="31">
        
        <!-- Disable Facebook SDK auto-initialization until configured -->
        <meta-data
            android:name="com.facebook.sdk.AutoInitEnabled"
            android:value="false" />
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.HomeRepairs.AppCompat">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.HomeRepairs.AppCompat">
        </activity>
        <activity
            android:name=".PlumbingActivity"
            android:exported="false"
            android:label="Plumbing"
            android:theme="@style/Theme.HomeRepairs.AppCompat">
        </activity>
        <activity
            android:name=".ProviderProfileActivity"
            android:exported="false"
            android:label="Provider Profile"
            android:theme="@style/Theme.HomeRepairs.AppCompat">
        </activity>
        <activity
            android:name=".NewBookingActivity"
            android:exported="false"
            android:label="New Booking"
            android:theme="@style/Theme.HomeRepairs.AppCompat">
        </activity>
        <activity
            android:name=".BookingConfirmedActivity"
            android:exported="false"
            android:label="Booking Confirmed"
            android:theme="@style/Theme.HomeRepairs.AppCompat">
        </activity>
        <activity
            android:name=".BookingDetailsActivity"
            android:exported="false"
            android:label="Booking Details"
            android:theme="@style/Theme.HomeRepairs.AppCompat">
        </activity>
        <activity
            android:name=".ReviewConfirmActivity"
            android:exported="false"
            android:label="Review"
            android:theme="@style/Theme.HomeRepairs.AppCompat">
        </activity>
        <activity
            android:name=".BookingsActivity"
            android:exported="false"
            android:label="Bookings"
            android:theme="@style/Theme.HomeRepairs.AppCompat">
        </activity>
        <activity
            android:name=".MessagesActivity"
            android:exported="false"
            android:label="Messages"
            android:theme="@style/Theme.HomeRepairs.AppCompat">
        </activity>
        <activity
            android:name=".ChatActivity"
            android:exported="false"
            android:label="Chat"
            android:theme="@style/Theme.HomeRepairs.AppCompat">
        </activity>
        <activity
            android:name=".FavoritesActivity"
            android:exported="false"
            android:label="My Favorites"
            android:theme="@style/Theme.HomeRepairs.AppCompat">
        </activity>
        <activity
            android:name=".UserProfileActivity"
            android:exported="false"
            android:label="Profile"
            android:theme="@style/Theme.HomeRepairs.AppCompat">
        </activity>
        <activity
            android:name=".ForgotPasswordActivity"
            android:exported="false"
            android:label="Forgot Password"
            android:theme="@style/Theme.HomeRepairs.AppCompat">
        </activity>
        <activity
            android:name=".CheckEmailActivity"
            android:exported="false"
            android:label="Check Email"
            android:theme="@style/Theme.HomeRepairs.AppCompat">
        </activity>
        
        <!-- Firebase Cloud Messaging Service -->
        <service
            android:name=".services.NotificationService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>