<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.homerepairs">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>

    <application
        android:allowBackup="true"
        android:label="HomeRepairs"
        android:icon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HomeRepairs"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules">

        <!-- Google Maps API Key -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyDg-u7_cdNW2ZbCMmaLBTmK_YQ2FZ1mHiI"/>

        <activity
            android:name=".SplashScreen"
            android:theme="@style/Theme.HomeRepairs"
            android:exported="true"
            >
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <activity android:name=".MainActivity"/>
        <activity android:name=".SignInActivity"/>
        <activity android:name=".SignUpActivity"/>
        <activity android:name=".AddPropertyActivity"/>
        <activity android:name=".HomeActivity"/>
        <activity android:name=".SavedLocationActivity"/>
        <activity android:name=".ForgotActivity"/>
        <activity android:name=".VerifyOtpActivity"/>
    </application>
</manifest>
